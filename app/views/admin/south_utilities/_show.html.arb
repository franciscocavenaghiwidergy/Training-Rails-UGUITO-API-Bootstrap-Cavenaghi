panel 'Utility' do
  attributes_table_for south_utility do
    utility = locals[:south]
    row :name do
      utility.name
    end
    row :code do
      utility.code
    end
    row :base_url do
      utility.base_url
    end
    row :external_api_key do
      utility.external_api_key
    end
    row :external_api_secret do
      utility.external_api_secret
    end
    row :external_api_authentication_url do
      utility.external_api_authentication_url
    end
    row :books_data_url do
      utility.books_data_url
    end
    row :notes_data_url do
      utility.notes_data_url
    end
    row :notes_short_limit do
      utility.notes_short_limit.present? ? utility.notes_short_limit : "(por defecto: #{utility.class::SHORT_LIMIT})"
    end
    row :notes_medium_limit do
      utility.notes_medium_limit.present? ? utility.notes_medium_limit : "(por defecto: #{utility.class::MEDIUM_LIMIT})"
    end
  end
end
